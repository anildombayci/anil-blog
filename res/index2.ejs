<%- include('header.ejs') %>
<div class="container mt-5">
  <!-- Postları Gösterme -->
  <section class="articles">
    <div class="columns is-multiline">
      <% let posts = db.get("post") %> <!-- Veriyi doğru şekilde alıyoruz -->
      <% if (posts && Object.keys(posts).length > 0) { %> <!-- Boş post kontrolü -->
        <% Object.keys(posts).forEach(key => { %>
          <% let post = db.get("post." + key); %>
          <% if (post && !post.archived) { %> <!-- Arşivlenmemiş postları göster -->
            <div class="column is-one-third">
              <div class="card article modern-card">
                <div class="card-image">
                  <% if (post.image) { %>
                    <figure class="image is-4by3">
                      <img src="<%= post.image %>" alt="<%= post.title %>">
                    </figure>
                  <% } %>
                </div>
                <div class="card-content">
                  <div class="media">
                    <div class="media-content">
                      <p class="title article-title"><a href="/post/<%= key %>"><%= post.title %></a></p>
                      <div class="tags has-addons level-item">
                        <span class="tag is-rounded is-info"><i class="fas fa-user"></i> <%= post.author %></span>
                        <span class="tag is-rounded"><i class="far fa-calendar-alt"></i> <%= new Date(post.date).toLocaleString("tr-TR", { day: 'numeric', month: 'long', year: 'numeric' }) %></span>
                      </div>
                      <div class="content article-body">
                        <p><%= post.desc.length > 50 ? post.desc.substring(0, 50) + '...' : post.desc %></p>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          <% } %>
        <% }); %>
      <% } else { %>
        <p>Hiç post bulunamadı.</p> <!-- Postlar yoksa bilgilendirme mesajı -->
      <% } %>
    </div>
  </section>
