<!DOCTYPE html>
<%- include('header.ejs') %>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Popüler Konular</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bulma@0.9.4/css/bulma.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.1.1/css/all.min.css">
</head>
  <style>
    .modern-card {
      border-radius: 10px;
      overflow: hidden;
      box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
      transition: all 0.3s ease-in-out;
    }

    .modern-card:hover {
      box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
      transform: translateY(-2px);
    }

    .article-title {
      font-weight: bold;
      margin-bottom: 5px;
    }

    .article-body {
      margin-bottom: 10px;
    }

    .article-body p {
      font-size: 0.9em;
    }
  </style>
<body>
  <section class="section">
    <div class="container">
      <!-- <h1 class="title">Popüler Konular</h1> -->
      <div class="columns is-multiline">
        <% let posts = db.get("post") %> 
        <% if (posts && Object.keys(posts).length > 0) { %> 
          <% Object.keys(posts).forEach(key => { %>
            <% let post = db.get("post." + key); %>
            <% if (post && !post.archived) { %> 
              <div class="column is-one-third">
                <div class="card article modern-card">
                  <div class="card-image">
                    <% if (post.image) { %>
                      <figure class="image is-4by3">
                        <img src="<%= post.image %>" alt="<%= post.title %>">
                      </figure>
                    <% } %>
                  </div>
                  <div class="card-content">
                    <div class="media">
                      <div class="media-content">
                        <p class="title article-title is-4"><%= post.title %></a></p>
                        <div class="tags has-addons level-item">
                          <span class="tag is-rounded is-info is-light"><i class="fas fa-user"></i> <%= post.author %></span>
                          <span class="tag is-rounded is-light"><i class="far fa-calendar-alt"></i> <%= new Date(post.date).toLocaleString("tr-TR", { day: 'numeric', month: 'long', year: 'numeric' }) %></span>
                        </div>
                        <div class="content article-body">
                          <p><%= post.desc.length > 50 ? post.desc.substring(0, 50) + '...' : post.desc %></p>
                        </div>
                        <div class="has-text-right mt-3">
                          <a href="/post/<%= key %>" class="button is-small is-primary is-outlined">Devamını Oku</a>
                        </div>
                        <div class="level is-mobile mt-3">
                          <div class="level-left">
                            <a class="level-item">
                              <span class="icon is-small"><i class="fas fa-heart"></i></span>
                              <span><%= post.likes || 0 %></span>
                            </a>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            <% } %>
          <% }); %>
        <% } else { %>
          <p>Hiç post bulunamadı.</p> 
        <% } %>
      </div>
    </div>
  </section>
</body>
</html>
                      <%- include('footer.ejs') %>
